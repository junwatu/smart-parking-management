# Obtain these from your GridDB Cloud portal. Never commit your real .env.
GRIDDB_NOTIFICATION_PROVIDER='https://example.invalid/provider?token=replace-me'
GRIDDB_CLUSTER_NAME='your-cluster'
GRIDDB_DATABASE='your-database'
GRIDDB_USERNAME='your-user'
GRIDDB_PASSWORD='your-password'
GRIDDB_CONNECTION_ROUTE='PUBLIC'
GRIDDB_SSL_MODE='PREFERRED'
GRIDDB_REQUEST_TIMEOUT_MS='30000'

# All parking containers begin with this prefix; use a dedicated prefix/database.
PARKING_CONTAINER_PREFIX='parking_demo'
PARKING_MODE='native'
PARKING_API_HOST='127.0.0.1'
PARKING_API_PORT='3002'
# USD per started hour. Zero-duration parking is free.
PARKING_HOURLY_RATE='2.50'
# Optional absolute or bridge-relative Python interpreter path.
# PYTHON_BIN='./.venv/bin/python'
