  "cards": [
    {
      "dot": "cyan",
      "title": "Business records: 3 Collections",
      "items": [
        "spaces stores zone, type, hourly rate and enabled state.",
        "sessions is authoritative for availability and calculated fees.",
        "events records arrival/departure projections; event_id combines session ID and event type."
      ]
    },
    {
      "dot": "emerald",
      "title": "Occupancy projections: 25 TimeSeries",
      "items": [
        "occupancy stores lot-wide occupied count and capacity.",
        "sensor_A01 through sensor_C08 share the schema shown; vacant samples use an empty session_id.",
        "All TimeSeries use timestamp row keys. Sensor state is derived from sessions."
      ]
    },
    {
      "dot": "amber",
      "title": "Reading the schema",
      "items": [
        "PK denotes the GridDB row key. Relationship lines are application references, not database-enforced foreign keys.",
        "Container names are prefixed by PARKING_CONTAINER_PREFIX, omitted here for readability.",
        "A saved session and its event/telemetry projections are separate writes; partial projection failures return warnings."
      ]
    }
  ]
