  "cards": [
    {
      "dot": "cyan",
      "title": "Inputs and application",
      "items": [
        "Manual arrivals, departures and simulator controls enter through the dashboard.",
        "Node.js serves the UI, validates requests and matches worker replies.",
        "Its optional timer requests a simulated transition every five seconds; Python chooses the transition."
      ]
    },
    {
      "dot": "emerald",
      "title": "One worker, two responsibilities",
      "items": [
        "The worker starts the JVM, loads JARs and owns the GridDB store.",
        "parking.py runs inside that same process; it is not a separate service.",
        "Operations execute serially. Native timestamps are converted for JSON replies."
      ]
    },
    {
      "dot": "amber",
      "title": "Persistence and responses",
      "items": [
        "Collections hold spaces, sessions and audit events. TimeSeries hold lot and per-space occupancy.",
        "Sessions determine live availability; telemetry records projections of that state.",
        "Responses travel back through Python and Node.js to the browser. Event and telemetry writes are not atomic with session writes."
      ]
    }
  ]
