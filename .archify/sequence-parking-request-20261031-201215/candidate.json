  "cards": [
    {
      "dot": "cyan",
      "title": "Protocol boundaries",
      "items": [
        "HTTP connects the browser to the Node.js application.",
        "NDJSON travels over worker stdin/stdout, not a network API.",
        "The Python worker uses JPype and the Java client for native GridDB calls."
      ]
    },
    {
      "dot": "emerald",
      "title": "Scope of this sequence",
      "items": [
        "Native mode, new arrival happy path; database reads and projection writes are grouped.",
        "A persistent worker and store already exist before this request.",
        "The HTTPS Notification Provider URL configures discovery; it is not the GridDB Web API."
      ]
    },
    {
      "dot": "amber",
      "title": "Retries and partial failures",
      "items": [
        "Reuse the same UUID for the same logical arrival.",
        "A saved session remains valid if event or telemetry projections fail.",
        "Follow-up dashboard reads use the same worker and native connection."
      ]
    }
  ]
